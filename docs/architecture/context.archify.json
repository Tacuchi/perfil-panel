  "cards": [
    {
      "dot": "cyan",
      "title": "Cuándo ocurre cada conexión",
      "items": [
        "API: en cada pantalla y, con una recolección en curso, cada segundo",
        "Lector local: solo con el botón Leer desde mi máquina",
        "Publicación y correo: solo cuando la persona los abre",
        "Google Fonts: al cargar la página",
        "Orquestador: en cada push a main que no sea solo documentación"
      ]
    },
    {
      "dot": "emerald",
      "title": "Qué no es",
      "items": [
        "No es un servidor de datos: es un sitio estático",
        "No guarda ofertas ni el CV: todo vive en la API",
        "No postula ni envía correos por la persona",
        "No inicia sesión: eso lo hace el proxy de acceso"
      ]
    },
